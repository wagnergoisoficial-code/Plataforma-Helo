{
  "name": "youth-church-portal",
  "version": "1.0.0",
  "description": "Production-ready SaaS backend for Youth Church Portal",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node scripts/prisma-postgres.js && prisma generate --schema prisma/postgres/schema.prisma",
    "start:prod": "prisma migrate deploy --schema prisma/postgres/schema.prisma && node src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:postgres": "node scripts/prisma-postgres.js",
    "prisma:seed": "node prisma/seed.js",
    "seed:demo": "node prisma/seed-demo.js",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.5.0",
    "prisma": "^5.22.0",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.14",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": "22.x"
  }
}
