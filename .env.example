# ─── Desenvolvimento local (SQLite) ─────────────────────────────
DATABASE_URL="file:./prisma/dev.db"
PORT=3000
NODE_ENV=development

# Obrigatória em produção: 32+ caracteres aleatórios
# (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=

# ─── Produção (PostgreSQL) ──────────────────────────────────────
# DATABASE_URL="postgresql://utilizador:senha@host:5432/lidera"
# NODE_ENV=production
# CORS_ORIGIN=https://o-seu-site.onrender.com        (vários: separados por vírgula)
# PUBLIC_URL=https://a-sua-api.onrender.com           (na Render é automático)
# ADMIN_EMAIL=admin@o-seu-dominio.com                  (cria o 1.º administrador no arranque)
# ADMIN_PASSWORD=                                      (12+ caracteres)
# RATE_LIMIT_PER_MINUTE=600
# LOGIN_ATTEMPTS=10
